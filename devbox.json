{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.18.4/.schema/devbox.schema.json",
  "packages": [
    "uv@0.13.4"
  ],
  "shell": {
    "init_hook": [
      "echo 'Devbox shell initialized.'"
    ],
    "scripts": {
      "install": [
        "uv sync"
      ],
      "test": "uv run pytest",
      "coverage": "uv run pytest --cov --cov-report=term-missing",
      "lint": [
        "uv run ruff check",
        "uv run ruff format --check"
      ]
    }
  }
}
